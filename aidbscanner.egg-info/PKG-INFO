### Python SDK

#### 基础使用

```python
from core.scanner import MySQLScanner
from core.semantic_analyzer import SemanticAnalyzer

# 自动根据 .env 配置创建 LLM 客户端
scanner = MySQLScanner()
analyzer = SemanticAnalyzer(scanner=scanner)

with scanner:
    # 扫描数据库
    tables = scanner.scan_database("my_database")
    
    # 分析表语义
    for table in tables:
        table_semantic = analyzer.analyze_table(table, "my_database")
        print(f"表：{table_semantic.chinese_name}")
        print(f"定义：{table_semantic.business_definition}")
```

#### 手动指定 LLM 客户端

```python
from core.llm_client import OllamaClient, OpenAIClient

# 使用 Ollama
ollama_client = OllamaClient(
    host="http://localhost:11434",
    model="qwen2.5:7b"
)
analyzer = SemanticAnalyzer(scanner=scanner, llm_client=ollama_client)

# 使用 OpenAI 格式接口
openai_client = OpenAIClient(
    base_url="https://api.openai.com/v1",
    api_key="sk-xxx",
    model="gpt-3.5-turbo"
)
analyzer = SemanticAnalyzer(scanner=scanner, llm_client=openai_client)
```

#### 分析单个字段

```python
from core.scanner import MySQLScanner
from core.semantic_analyzer import SemanticAnalyzer

scanner = MySQLScanner()
analyzer = SemanticAnalyzer(scanner=scanner)

with scanner:
    # 获取表元数据
    tables = scanner.scan_database("ecommerce")
    orders_table = next(t for t in tables if t.table_name == "orders")
    user_id_col = next(c for c in orders_table.columns if c.column_name == "user_id")
    
    # 获取示例数据
    sample_values = scanner.get_sample_data("ecommerce", "orders", "user_id", limit=5)
    
    # 分析字段语义
    semantic = analyzer.analyze_field(user_id_col, "orders", "ecommerce", sample_values)
    
    print(f"中文名称：{semantic.chinese_name}")
    print(f"业务定义：{semantic.business_definition}")
    print(f"数据分类：{semantic.data_category.value}")
```

#### 批量分析表

```python
scanner = MySQLScanner()
analyzer = SemanticAnalyzer(scanner=scanner)

with scanner:
    tables = scanner.scan_database("ecommerce")
    
    # 批量分析所有表
    table_semantics = analyzer.batch_analyze_tables(
        tables, 
        "ecommerce", 
        sample_data_size=5
    )
    
    for ts in table_semantics:
        print(f"\n表：{ts.chinese_name} ({ts.table_name})")
        print(f"分类：{ts.data_category.value}")
        for fs in ts.field_semantics:
            print(f"  - {fs.column_name}: {fs.chinese_name}")
```

#### 发现表间关系

```python
from core.scanner import MySQLScanner
from core.semantic_analyzer import SemanticAnalyzer
from config.settings import settings

scanner = MySQLScanner()
analyzer = SemanticAnalyzer(scanner=scanner)

with scanner:
    tables = scanner.scan_database("ecommerce")
    
    # 发现候选关系
    candidates = scanner.discover_foreign_key_candidates(tables)
    
    for rel in candidates:
        # 计算匹配率
        match_rate = scanner.calculate_match_rate("ecommerce", rel)
        rel.match_rate = match_rate
        
        if match_rate >= settings.relationship_match_threshold:
            # 使用 LLM 验证
            is_valid = analyzer.verify_relationship(rel)
            rel.verified = is_valid
            
            if is_valid:
                print(f"发现关系：{rel.source_table}.{rel.source_column} "
                      f"-> {rel.target_table}.{rel.target_column}")
```

#### 使用工厂函数创建客户端

```python
from core.llm_client import LLMProvider, create_llm_client

# 创建 Ollama 客户端
client = create_llm_client(LLMProvider.OLLAMA, {
    "host": "http://localhost:11434",
    "model": "qwen2.5:7b"
})

# 创建 OpenAI 客户端
client = create_llm_client(LLMProvider.OPENAI, {
    "base_url": "https://api.openai.com/v1",
    "api_key": "sk-xxx",
    "model": "gpt-3.5-turbo"
})

analyzer = SemanticAnalyzer(scanner=scanner, llm_client=client)
```

## 项目结构

```
aidbscanner/
├── app/                    # FastAPI 应用层
│   ├── __init__.py        # API 端点定义
│   └── schemas.py         # Pydantic 数据模型
├── cli/                    # CLI 命令行接口
│   └── __init__.py        # Click 命令定义
├── config/                 # 配置管理
│   ├── __init__.py
│   └── settings.py        # 配置类
├── core/                   # 核心模块
│   ├── __init__.py
│   ├── chroma_store.py    # ChromaDB 向量存储
│   ├── llm_client.py      # LLM 客户端抽象层
│   ├── models.py          # 数据模型
│   ├── scanner.py         # MySQL 扫描器
│   └── semantic_analyzer.py # 语义分析器
├── tests/                  # 单元测试
│   ├── test_models.py
│   ├── test_scanner.py
│   └── test_semantic_analyzer.py
├── .env.example           # 环境变量示例
├── pytest.ini             # Pytest 配置
├── requirements.txt       # 依赖列表
└── README.md              # 项目文档
```

## 运行测试

```bash
# 运行所有测试
pytest

# 运行特定测试文件
pytest tests/test_scanner.py -v

# 运行带覆盖率报告
pytest --cov=core --cov-report=html
```

## 核心概念

### 数据分类

- **Dimension（维度）**：描述业务实体的属性，如用户、产品
- **Metric（指标）**：可量化的业务度量，如销售额、数量
- **Fact（事实）**：记录业务事件的数据，如订单、交易
- **Other（其他）**：无法归类的字段

### 关系发现

工具通过以下两步发现外键关系：

1. **命名规则匹配**：识别 `_id` 后缀字段，匹配可能的目标表
2. **数据匹配率计算**：通过 SQL JOIN 计算值匹配率，使用 LLM 验证语义合理性

