# MySQL 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=your_database

# LLM 提供商选择：ollama 或 openai
LLM_PROVIDER=ollama

# Ollama 配置 (当 LLM_PROVIDER=ollama 时使用)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120

# OpenAI 格式接口配置 (当 LLM_PROVIDER=openai 时使用)
# 可用于：OpenAI 官方 API、Azure OpenAI、vLLM、其他兼容接口
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_api_key
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TIMEOUT=120

# 语义解析配置
SAMPLE_DATA_SIZE=5
RELATIONSHIP_MATCH_THRESHOLD=0.95

# 语义存储配置
# 存储类型：chroma（ChromaDB 本地持久化）或 milvus（向量数据库）
SEMANTIC_STORAGE_TYPE=chroma
# ChromaDB 存储路径（仅当 SEMANTIC_STORAGE_TYPE=chroma 时有效）
SEMANTIC_STORAGE_PATH=./data/chroma
# Milvus 向量数据库配置（仅当 SEMANTIC_STORAGE_TYPE=milvus 时有效）
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=db_semantics

# FastAPI 服务配置
API_HOST=0.0.0.0
API_PORT=8000

# 运行模式配置
# auto: LLM 分析结果直接保存，无需人工审核
# review: LLM 分析结果待审核，需通过 CLI/API 确认
RUNTIME_MODE=auto
